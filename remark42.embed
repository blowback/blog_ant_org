<script>
  var remark_config = {
    host: "https://comments.ant.org",
    site_id: "blog",
    components: ["embed"],
    theme: "light"
  };
  (function(c){for(var i=0;i<c.length;i++){var d=document,s=d.createElement('script');s.src=remark_config.host+'/web/'+c[i]+'.js';s.defer=true;(d.head||d.body).appendChild(s);}})(remark_config.components);
</script>
