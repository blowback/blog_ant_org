#cloud-config
# Minimal cloud-init: NO multi-line content blocks, NO indent() calls.
# - The only inline file is /opt/blog/.env, written via base64 (encoding: b64),
#   so it has zero significant whitespace and cannot be broken by YAML/indent.
# - Every other file (docker-compose.yml, Caddyfile, backup.sh, cron) lives in
#   the public repo as a normal file and is git-cloned onto the box verbatim.
package_update: true
packages:
  - awscli
  - cron
  - git

write_files:
  - path: /opt/blog/.env
    permissions: '0600'
    encoding: b64
    content: ${base64encode(env_file)}

runcmd:
  - curl -fsSL https://get.docker.com | sh
  - git clone --depth 1 ${repo_url} /opt/blog/repo
  - cp /opt/blog/repo/deploy/docker-compose.yml /opt/blog/docker-compose.yml
  - cp /opt/blog/repo/deploy/Caddyfile         /opt/blog/Caddyfile
  - cp /opt/blog/repo/deploy/backup.sh         /opt/blog/backup.sh
  - cp /opt/blog/repo/deploy/blog-backup.cron  /etc/cron.d/blog-backup
  - chmod 0750 /opt/blog/backup.sh
  - chmod 0644 /etc/cron.d/blog-backup
  - cd /opt/blog && docker compose up -d
  - systemctl enable --now cron
