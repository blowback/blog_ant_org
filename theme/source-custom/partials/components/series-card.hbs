{{!--
    A magazine card for a tutorial series on the Beast User hub.

    Rendered inside a {{#foreach pages}} over the series' masthead page, so the
    current context is that page — title / custom_excerpt / feature_image all
    come from it. The link target is the series CHANNEL, passed in as `url`
    (the page's own url would point at the bare page, not the ordered channel).

    Parameters:
    * url   — the channel URL, e.g. /beast-user/your-name-in-lights/
    * label — small kicker above the title (defaults to "Series")
--}}
<article class="gh-card post{{#unless @custom.show_images_in_feed}} no-image{{/unless}}">
    <a class="gh-card-link" href="{{url}}">
        {{#if feature_image}}
            <figure class="gh-card-image">
                <img
                    srcset="{{img_url feature_image size="xs" format="webp"}} 160w,
                            {{img_url feature_image size="s" format="webp"}} 320w,
                            {{img_url feature_image size="m" format="webp"}} 600w,
                            {{img_url feature_image size="l" format="webp"}} 960w,
                            {{img_url feature_image size="xl" format="webp"}} 1200w,
                            {{img_url feature_image size="xxl" format="webp"}} 2000w"
                    sizes="{{#if imageSizes}}{{imageSizes}}{{else}}320px{{/if}}"
                    src="{{img_url feature_image size="m"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    loading="lazy"
                >
            </figure>
        {{/if}}
        <div class="gh-card-wrapper">
            <p class="gh-card-tag">{{#if label}}{{label}}{{else}}Series{{/if}}</p>
            <h3 class="gh-card-title is-title">{{title}}</h3>
            {{#if custom_excerpt}}
                <p class="gh-card-excerpt is-body">{{custom_excerpt}}</p>
            {{/if}}
        </div>
    </a>
</article>
